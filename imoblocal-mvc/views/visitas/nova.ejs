<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Agendar visita - ImóbLocal</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="card">
    <h1>Agendar visita</h1>

    <% if (erro) { %>
      <p class="erro"><%= erro %></p>
    <% } %>

    <form method="post" action="/visitas">
      <label for="imovelId">Imóvel</label>
      <select id="imovelId" name="imovelId" required>
        <% imoveis.forEach(i => { %>
          <option value="<%= i.id %>" <%= String(valores.imovelId) === String(i.id) ? 'selected' : '' %>>
            <%= i.id %> - <%= i.descricao %>
          </option>
        <% }) %>
      </select>

      <label for="corretor">Corretor</label>
      <input id="corretor" name="corretor" value="<%= valores.corretor || '' %>" required>

      <label for="inicio">Data e hora</label>
      <input id="inicio" name="inicio" type="datetime-local" value="<%= valores.inicio || '' %>" required>

      <label for="duracaoMin">Duração (minutos)</label>
      <input id="duracaoMin" name="duracaoMin" type="number" min="15" step="15" value="<%= valores.duracaoMin || 60 %>">

      <button type="submit">Agendar</button>
    </form>

    <p><a href="/visitas">Ver agenda</a></p>
  </main>
</body>
</html>
